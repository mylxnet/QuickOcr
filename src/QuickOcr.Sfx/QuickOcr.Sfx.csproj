<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>QuickOcr_Setup</AssemblyName>
    <RootNamespace>QuickOcr.Sfx</RootNamespace>
    <Version>1.0.1</Version>
    <Company>QuickOcr</Company>
  </PropertyGroup>

  <!-- publish.zip 由 build.ps1 第 2 步生成（主程序 publish 后打包）。
       单独 build 本项目时若缺失，则生成占位文件让编译通过；正式发布走 build.ps1 全流程。 -->
  <Target Name="EnsurePublishZip" BeforeTargets="PrepareForBuild">
    <WriteLinesToFile
      Condition="!Exists('publish.zip')"
      File="publish.zip"
      Lines="placeholder - not a real installer payload"
      Overwrite="false" />
  </Target>

  <ItemGroup>
    <EmbeddedResource Include="publish.zip" />
  </ItemGroup>

</Project>
